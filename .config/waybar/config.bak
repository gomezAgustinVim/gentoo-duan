{
  "layer": "top",
  "output": ["HDMI-A-1", "eDP-1"],
  "spacing": 0,
  "height": 0,

  "modules-left": ["hyprland/workspaces"],

  "modules-center": ["mpd"],

  "modules-right": [
    "clock",
    "battery",
    "wireplumber",
    "cpu",
    "backlight",
    "tray"
  ]
},

{
    "hyprland/workspaces": {
        "format": "{name}:{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "active": "",
            "default": ""
        },
        "sort-by-number": true
    },
    "hyprland/window": {
        "separate-outputs": true
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d/%m/%Y}",
        "on-click-right": "footclient -e calcure",
        "tooltip": true,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "rotate": 0,
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip": true
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "wireplumber": {
        "max-volume": 150,
        "nospacing": 1,
        "tooltip": true,
        "scroll-step": 5,
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": "󰝟 {volume}%",
        "on-click": "pavucontrol",
        "format-icons": [
            "",
            "",
            ""
        ]
    },
    "mpd": {
        "format": "{stateIcon} {consumeIcon} {artist} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ",
        "format-disconnected": "Dekonetado nwnww ",
        "format-stopped": "{consumeIcon} Detenido ",
        "interval": 10,
        "on-click": "mpc toggle",
        "on-click-right": "footclient -- ncmpcpp",
        "on-scroll-up": "mpc seek +3",
        "on-scroll-down": "mpc seek -3",
        "artist-len": 20,
        "title-len": 20,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (conetado nwnw)",
        "tooltip-format-disconnected": "MPD (dekonetado nwnw)"
    },
    "custom/bluetooth": {
        "format": " {}",
        "exec": "~/.config/waybar/scripts/bluetooth-display.sh",
        "interval": 2,
        "on-click": "blueman-manager",
        "return-type": "plain",
        "tooltip": true,
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "max-length": 25
    },
    "cpu": {
        "format": " {usage}%",
        "on-click": "footclient -- htop",
        "tooltip": true
    },
    "tray": {
        "icon-size": 14,
        "rotate": 0,
        "spacing": 5,
        "tooltip": true
    },
    "memory": {
        "interval": 30,
        "format": "  {used:0.1f}G/{total:0.1f}G",
        "max-length": 20
    }
}
